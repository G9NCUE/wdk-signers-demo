# Read by the signer service only (node --env-file=.env server/index.js). Never reaches the browser.
# A provider with missing variables shows as unavailable in the UI, with the reason.

# Turnkey, https://app.turnkey.com, an API key on the organisation and an HD wallet
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_WALLET_ID=
# TURNKEY_BASE_URL=https://api.turnkey.com

# Dfns, https://app.dfns.io, a service account with a P-256 key and a master key to derive from
DFNS_AUTH_TOKEN=
DFNS_CRED_ID=
DFNS_PRIVATE_KEY_FILE=./dfns-service-account.pem
DFNS_MASTER_KEY_ID=
DFNS_NETWORK=EthereumSepolia
# DFNS_API_URL=https://api.dfns.io

# Openfort, https://dashboard.openfort.io, a test secret key, the wallet secret from
# `openfort backend-wallet setup`, and one backend account (acc_...)
OPENFORT_SECRET_KEY=
OPENFORT_WALLET_SECRET=
OPENFORT_ACCOUNT_ID=

# Fireblocks sandbox, https://sandbox.fireblocks.io. An API user with the Signer role, Developer Center > API Users:
# let the console generate the key pair and save the downloaded private key here, or upload a CSR made with
# openssl req -new -newkey rsa:4096 -nodes -keyout fireblocks_secret.key -out fireblocks.csr
# Then node --env-file=.env server/setup-fireblocks.mjs creates the vault account holding ETH_TEST5
FIREBLOCKS_API_KEY=
FIREBLOCKS_SECRET_KEY_FILE=./fireblocks_secret.key
FIREBLOCKS_VAULT_ACCOUNT_ID=
# FIREBLOCKS_BASE_PATH=sandbox

# WDK indexer, https://wdk-api.tether.io/register, for the USDT half of the history. Optional.
WDK_INDEXER_API_KEY=

# Browser side, optional, read by Vite
# VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Service and history endpoints, optional
# SIGNER_SERVICE_PORT=8787
# SIGNER_SERVICE_URL=http://127.0.0.1:8787/api     # for server/probe.js
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# BLOCKSCOUT_URL=https://eth-sepolia.blockscout.com
# WDK_INDEXER_URL=https://wdk-api.tether.io
# FIREBLOCKS_ASSET_ID=ETH_TEST5
