# Read by the signer service only (node --env-file=.env server/index.js). Never reaches the browser.
# A provider with missing variables shows as unavailable in the UI, with the reason.

# Turnkey, https://app.turnkey.com, an API key on the organisation and an HD wallet
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_WALLET_ID=
# TURNKEY_BASE_URL=https://api.turnkey.com

# Dfns, https://app.dfns.io, a service account with a P-256 key and a master key to derive from
DFNS_AUTH_TOKEN=
DFNS_CRED_ID=
DFNS_PRIVATE_KEY_FILE=./dfns-service-account.pem
DFNS_MASTER_KEY_ID=
DFNS_NETWORK=EthereumSepolia
# DFNS_API_URL=https://api.dfns.io

# Openfort, https://dashboard.openfort.io, a test secret key, the wallet secret from
# `openfort backend-wallet setup`, and one backend account (acc_...)
OPENFORT_SECRET_KEY=
OPENFORT_WALLET_SECRET=
OPENFORT_ACCOUNT_ID=

# Fireblocks sandbox, https://sandbox.fireblocks.io, an API user with the Signer role,
# its RSA private key, and a vault account holding ETH_TEST5
FIREBLOCKS_API_KEY=
FIREBLOCKS_SECRET_KEY_FILE=./fireblocks_secret.key
FIREBLOCKS_VAULT_ACCOUNT_ID=
# FIREBLOCKS_BASE_PATH=sandbox

# Browser side, optional, read by Vite
# VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
